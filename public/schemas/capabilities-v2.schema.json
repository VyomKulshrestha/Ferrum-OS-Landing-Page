{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferrum-os.vercel.app/schemas/capabilities-v2.schema.json",
  "title": "FerrumOS capability catalog",
  "type": "object",
  "required": ["schemaVersion", "project", "source", "counts", "safety", "actions", "claimBoundaries"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "project": { "const": "FerrumOS" },
    "source": { "type": "object", "required": ["repository", "commit", "sha256"] },
    "counts": { "type": "object", "required": ["canonicalExecutableOperations", "kernelSyscalls", "permissionTiers"] },
    "safety": { "type": "object", "required": ["learnedAllowGrantsAuthority"] },
    "actions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "permission_tier", "operator_confirmation_required", "world_model_previewed"] } },
    "claimBoundaries": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
